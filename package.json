{
  "name": "checkout-pix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./styles/input.css -o ./public/app.css --minify",
    "postinstall": "npm run build:css",
    "migrate": "node src/migrate.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8"
  }
}
