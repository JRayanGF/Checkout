# ===== Servidor =====
NODE_ENV=development
PORT=3000
# URL pública do site (HTTPS em produção). Usada no webhook do Mercado Pago.
APP_URL=http://localhost:3000

# ===== Banco de dados (PostgreSQL) =====
DATABASE_URL=postgres://checkout:troque_esta_senha@localhost:5432/checkout
# Defina como true em provedores que exigem SSL (Render, Railway, Neon...)
DATABASE_SSL=false

# ===== Segurança =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Usuário administrador criado pelo comando "npm run migrate" (somente se ainda não existir nenhum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Mercado Pago (https://www.mercadopago.com.br/developers) =====
# Use credenciais de TESTE no início e de PRODUÇÃO ao publicar.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Chave secreta exibida ao configurar o webhook em "Suas integrações > Webhooks"
MP_WEBHOOK_SECRET=

# ===== E-mail (opcional; sem SMTP_HOST os e-mails não são enviados) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Minha Loja <pedidos@seudominio.com.br>"
